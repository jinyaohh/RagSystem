# ============================================================================
# Financial RAG System - Backend Configuration
# ============================================================================
# Copy this file to .env and fill in your values

# ============================================================================
# Application Settings
# ============================================================================
APP_NAME="Financial RAG System"
APP_VERSION="0.1.0"
ENVIRONMENT="development"  # development, staging, production
DEBUG=True
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ============================================================================
# API Configuration
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True  # Auto-reload on code changes (dev only)

# CORS
CORS_ORIGINS=["http://localhost:3000"]  # Comma-separated list

# ============================================================================
# LLM Provider Configuration (Flexible)
# ============================================================================
# Supported: openai, anthropic, local
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview  # gpt-4-turbo-preview, gpt-4, gpt-3.5-turbo
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=2048
OPENAI_TIMEOUT=60

# Anthropic Configuration (if using Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229  # claude-3-opus, claude-3-sonnet
ANTHROPIC_TEMPERATURE=0.1
ANTHROPIC_MAX_TOKENS=2048

# Local LLM Configuration (if using local model)
LOCAL_LLM_MODEL_PATH=/path/to/local/model
LOCAL_LLM_MODEL_TYPE=llama  # llama, mistral, etc.

# ============================================================================
# Embedding Provider Configuration (Flexible)
# ============================================================================
# Supported: openai, local, sentence-transformers
EMBEDDING_PROVIDER=openai

# OpenAI Embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-large  # text-embedding-3-large, text-embedding-3-small
EMBEDDING_DIMENSION=3072  # 3072 for large, 1536 for small

# Local Embeddings (sentence-transformers)
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
LOCAL_EMBEDDING_DIMENSION=768

# ============================================================================
# Vector Database Configuration
# ============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=  # Optional, for Qdrant Cloud
QDRANT_COLLECTION_NAME=financial_documents
QDRANT_USE_GRPC=False  # Set to True for better performance

# ============================================================================
# Document Processing Configuration
# ============================================================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800  # 50MB in bytes
ALLOWED_FILE_TYPES=pdf,docx,xlsx,txt

# Text Chunking
CHUNK_SIZE=1024
CHUNK_OVERLAP=128
CHUNK_STRATEGY=recursive  # recursive, character, token

# ============================================================================
# RAG Configuration
# ============================================================================
# Retrieval
TOP_K=5  # Number of chunks to retrieve
SIMILARITY_THRESHOLD=0.7  # Minimum similarity score
RERANK_ENABLED=False  # Enable re-ranking (Phase 2)

# Response Generation
STREAM_RESPONSE=False  # Enable streaming (Phase 2)
INCLUDE_SOURCES=True  # Include source citations
MAX_CONTEXT_LENGTH=4000  # Max tokens for context

# ============================================================================
# Performance & Caching
# ============================================================================
# Redis (Phase 3)
REDIS_ENABLED=False
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL=3600  # seconds

# ============================================================================
# Async Processing (Phase 2)
# ============================================================================
CELERY_ENABLED=False
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============================================================================
# Database & Authentication (Phase 2)
# ============================================================================
# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # Optional, for admin operations

# Authentication
AUTH_ENABLED=False  # Set to True to enable authentication (Phase 2)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase Storage
SUPABASE_STORAGE_BUCKET=documents

# ============================================================================
# Monitoring & Logging
# ============================================================================
# Sentry (optional)
SENTRY_ENABLED=False
SENTRY_DSN=

# File Logging
LOG_TO_FILE=True
LOG_FILE_PATH=./logs/app.log
LOG_ROTATION=10MB  # Rotate when file reaches this size

# ============================================================================
# Development & Testing
# ============================================================================
# Test mode (uses mock services)
TEST_MODE=False

# Sample data path
SAMPLE_DATA_PATH=./test_data
