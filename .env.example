# =================================================================
# Financial Reports RAG System - Environment Configuration
# =================================================================
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file to version control!

# =================================================================
# Application Settings
# =================================================================
APP_NAME="Financial RAG System"
APP_VERSION="1.0.0"
ENVIRONMENT="development"  # development, staging, production
DEBUG=True

# =================================================================
# API Keys
# =================================================================
# OpenAI API Key (Required)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (Optional - alternative to OpenAI)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =================================================================
# Database Configuration
# =================================================================
# PostgreSQL
DATABASE_URL=postgresql://raguser:ragpassword@localhost:5432/ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=ragdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# =================================================================
# Redis Configuration
# =================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Cache TTL (in seconds)
CACHE_TTL=3600

# =================================================================
# Vector Database (Qdrant)
# =================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=financial_documents

# Vector dimensions (match your embedding model)
# text-embedding-3-large: 3072
# text-embedding-3-small: 1536
VECTOR_DIMENSION=3072

# =================================================================
# Security & Authentication
# =================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your_secret_key_here_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOW_CREDENTIALS=True

# =================================================================
# LLM Configuration
# =================================================================
# Model Selection
LLM_PROVIDER=openai  # openai, anthropic
LLM_MODEL=gpt-4-turbo-preview  # gpt-4-turbo-preview, gpt-3.5-turbo, claude-3-sonnet-20240229
EMBEDDING_MODEL=text-embedding-3-large  # text-embedding-3-large, text-embedding-3-small

# LLM Parameters
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TOP_P=1.0

# Rate Limiting
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT=60

# =================================================================
# RAG Configuration
# =================================================================
# Document Chunking
CHUNK_SIZE=1024
CHUNK_OVERLAP=128
CHUNKING_STRATEGY=recursive  # recursive, semantic, fixed

# Retrieval
TOP_K=5  # Number of chunks to retrieve
SIMILARITY_THRESHOLD=0.7
RERANK_ENABLED=True

# Hybrid Search
HYBRID_SEARCH_ENABLED=True
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3

# =================================================================
# File Upload Settings
# =================================================================
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE=52428800  # 50MB in bytes
ALLOWED_EXTENSIONS=pdf,docx,xlsx,txt,csv

# =================================================================
# Celery Configuration
# =================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC

# =================================================================
# Logging Configuration
# =================================================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json, text
LOG_FILE=./logs/app.log

# =================================================================
# Frontend Configuration
# =================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME="Financial RAG System"

# =================================================================
# Monitoring & Observability
# =================================================================
# Sentry (Error Tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Prometheus
PROMETHEUS_ENABLED=True
PROMETHEUS_PORT=9090

# =================================================================
# Rate Limiting
# =================================================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# =================================================================
# Email Configuration (Optional)
# =================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourapp.com

# =================================================================
# Backup & Storage
# =================================================================
BACKUP_ENABLED=True
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# =================================================================
# Feature Flags
# =================================================================
ENABLE_DOCUMENT_UPLOAD=True
ENABLE_STREAMING=True
ENABLE_FEEDBACK=True
ENABLE_ANALYTICS=True
ENABLE_MULTIMODAL=False

# =================================================================
# Development Tools
# =================================================================
# Auto-reload on code changes
AUTO_RELOAD=True

# API Documentation
DOCS_ENABLED=True
DOCS_URL=/docs
REDOC_URL=/redoc

# =================================================================
# Production Overrides (use in production .env)
# =================================================================
# ENVIRONMENT=production
# DEBUG=False
# LOG_LEVEL=WARNING
# DOCS_ENABLED=False
